#!/bin/sh
# Maemo/Hildon desktop launcher for fremarble. Installed as /usr/bin/fremarble
# by desktop/install.sh; the app-grid entry passes no arguments, and game.py
# with no argument plays the whole levels/ pack, level to level.
set -e
GAMEDIR=/home/user/MyDocs/fremarble
LOG="$GAMEDIR/fremarble.log"
cd "$GAMEDIR"
exec python2.5 game.py >>"$LOG" 2>&1
