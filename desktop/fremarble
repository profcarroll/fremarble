#!/bin/sh
# Maemo/Hildon desktop launcher for fremarble. Installed as /usr/bin/fremarble
# by desktop/install.sh; the app-grid entry has no arguments, so play the
# designer-generated pack in order, falling back to the one hand-made level
# if no pack has been deployed yet. game.py's own --pack mode keeps a single
# pygame window open across levels and shows a summary card at the end,
# instead of this script relaunching it per level.
set -e
GAMEDIR=/home/user/MyDocs/fremarble
LOG="$GAMEDIR/fremarble.log"
cd "$GAMEDIR"

# An interrupted run_pack.sh session (or a previous crash) can leave a
# fullscreen game.py holding the framebuffer; clear it before claiming it.
pkill -f 'python2.5 game.py' 2>/dev/null || true

LEVELS=$(ls levels/generated/*.lvl 2>/dev/null | sort)
if [ -z "$LEVELS" ]; then
    LEVELS=levels/001-first-tilt.lvl
fi

exec python2.5 game.py --pack $LEVELS >"$LOG" 2>&1
