def hole_hit(px, py, r, holes):
    """Return index of first overlapping hole.
Marble center is (px, py) with radius r.
holes is a list of (x, y, radius); return -1 if none."""
    i = 0
    while i < len(holes):
        hx, hy, hr = holes[i]
        dx = px - hx
        dy = py - hy
        s = r + hr
        if dx * dx + dy * dy <= s * s:
            return i
        i += 1
    return -1


