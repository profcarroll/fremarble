def hole_hit(px, py, r, holes):
    """
    Check each hole for overlap with the marble.
    Return the index of the first matching hole.
    A touch or intersection counts as a hit.
    """
    for i, hole in enumerate(holes):
        hx, hy, hr = hole
        dx = px - hx
        dy = py - hy
        if dx * dx + dy * dy <= (r + hr) * (r + hr):
            return i
    return -1


