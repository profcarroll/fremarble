def hole_hit(px, py, r, holes):
    """Return index of first hole overlapping the marble.
    Holes are represented as (x, y, radius) tuples.
    Returns the first matching index, or -1."""
    for i, (hx, hy, hr) in enumerate(holes):
        dx = px - hx
        dy = py - hy
        if dx * dx + dy * dy <= (r + hr) * (r + hr):
            return i
    return -1


